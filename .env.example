DATABASE_URL="postgresql://postgres:password@localhost:5432/bien_phim_db?schema=public"
JWT_SECRET="your_jwt_secret_key_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_key_here"
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
GEMINI_API_KEY="your_gemini_api_key_here"
APP_URL="http://localhost:3000"

# Video aggregator (optional)
# Comma separated hostnames the scraper is allowed to fetch. Leave empty to allow any public host.
AGGREGATOR_ALLOWED_HOSTS=""
# JSON array of search sources, e.g.
# [{"type":"json","name":"my-feed","searchUrl":"https://feed.example.com/search?q={query}","itemsPath":"data.items","fields":{"title":"name","url":"stream"}}]
AGGREGATOR_SOURCES="[]"

# Admin account created by `pnpm db:seed` (skipped when unset). Grants access to /api/v1/aggregator.
ADMIN_EMAIL=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
