# Postgres connection string. In production, use your managed database's
# connection string (Neon, Supabase, RDS, etc.) — include ?sslmode=require
# if your provider needs it.
DATABASE_URL="postgresql://postgres:password@localhost:5432/bien_phim_db?schema=public"

# Required in production. Leave unset in local dev and a random one is
# generated per-process automatically. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""

PORT=3000
NODE_ENV="development"

# Required in production — set to your real deployed origin, e.g.
# "https://bienphim.vn". Requests from other origins are rejected.
CORS_ORIGIN="http://localhost:3000"

GEMINI_API_KEY="your_gemini_api_key_here"
APP_URL="http://localhost:3000"

# Video aggregator (optional)
# Comma separated hostnames the scraper is allowed to fetch. Leave empty to allow any public host.
AGGREGATOR_ALLOWED_HOSTS=""
# JSON array of search sources, e.g.
# [{"type":"json","name":"my-feed","searchUrl":"https://feed.example.com/search?q={query}","itemsPath":"data.items","fields":{"title":"name","streamUrl":"stream"}}]
AGGREGATOR_SOURCES="[]"

# Admin account created by `pnpm db:seed` (skipped when unset). Grants access to /api/v1/aggregator.
ADMIN_EMAIL=""
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# OMDb API key from omdbapi.com/apikey.aspx — get the paid tier if this is
# a commercial product (the free tier is personal-use only per their terms).
# Used by the admin "Nhập metadata" page and `npm run import:omdb`.
OMDB_API_KEY=""

# TMDB "API Read Access Token" (v4, JWT-style) from
# themoviedb.org/settings/api. Only used for real backdrop/landscape images
# (OMDb has none) via `npm run import:tmdb-backdrops` — commercial use is
# fine with attribution ("This product uses the TMDB API but is not
# endorsed or certified by TMDB"). If themoviedb.org won't load in your
# browser, your ISP is likely blocking DNS for it — the import script
# itself works around that, but signing up for the key still needs you to
# reach the site once (switch DNS to 8.8.8.8/1.1.1.1, or use mobile data).
TMDB_API_TOKEN=""
# TMDB response language for metadata imports (en-US keeps titles consistent
# with the existing catalogue; vi-VN gives Vietnamese titles/overviews where
# TMDB has them, falling back to English overviews).
TMDB_LANGUAGE="en-US"
# "true" makes the server resolve api.themoviedb.org / omdbapi.com via public
# DNS (8.8.8.8, 1.1.1.1) — for networks whose DNS blocks themoviedb.org.
METADATA_PUBLIC_DNS="false"

# Background worker (`pnpm worker`; see README "Background worker").
# Jobs run in parallel per worker (keep low: TMDB rate-limits).
WORKER_CONCURRENCY="1"
# "off" skips the daily stale-metadata refresh the worker queues after 19:00 UTC.
WORKER_SCHEDULES="on"
# "pretty" for human-readable worker logs; default is one JSON object per line.
LOG_FORMAT=""
