generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  username     String          @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         String          @default("USER")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  ratings      Rating[]
  preference   UserPreference?
  watchHistory WatchHistory[]
  progress     WatchProgress[]
  watchlist    Watchlist[]

  @@index([email])
  @@index([username])
}

model UserPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  favoriteGenres        String[] @default([])
  favoriteMoods         String[] @default([])
  favoriteLanguages     String[] @default([])
  preferredRuntime      String?
  preferredContentTypes String[] @default([])
  preferredProviders    String[] @default([])
  editorialSummary      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Movie {
  id                  String            @id @default(uuid())
  slug                String            @unique
  title               String
  originalTitle       String?
  tagline             String?
  synopsis            String
  year                Int
  runtimeMinutes      Int
  rating              Float             @default(0.0)
  posterUrl           String
  backdropUrl         String
  monochromePosterUrl String?
  type                MediaType         @default(MOVIE)
  status              MediaStatus       @default(RELEASED)
  isCoverFeature      Boolean           @default(false)
  isTrending          Boolean           @default(false)
  editorialQuote      String?
  isAiFilm            Boolean           @default(false)
  toolsUsed           String[]          @default([])
  promptDirector      String?
  workflowNotes       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  aiInsight           AIInsight?
  availability        Availability[]
  collectionItems     CollectionMovie[]
  creators            MovieCreator[]
  genres              MovieGenre[]
  moods               MovieMood[]
  ratings             Rating[]
  subtitles           Subtitle[]
  watchHistory        WatchHistory[]
  watchProgress       WatchProgress[]
  watchlist           Watchlist[]

  @@index([title])
  @@index([slug])
  @@index([year])
  @@index([rating])
  @@index([type])
  @@index([isTrending])
}

model Series {
  id                  String             @id @default(uuid())
  slug                String             @unique
  title               String
  originalTitle       String?
  tagline             String?
  synopsis            String
  startYear           Int
  endYear             Int?
  rating              Float              @default(0.0)
  posterUrl           String
  backdropUrl         String
  monochromePosterUrl String?
  status              MediaStatus        @default(RELEASED)
  isCoverFeature      Boolean            @default(false)
  isTrending          Boolean            @default(false)
  editorialQuote      String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  aiInsight           AIInsight?
  availability        Availability[]
  collectionItems     CollectionSeries[]
  ratings             Rating[]
  seasons             Season[]
  creators            SeriesCreator[]
  genres              SeriesGenre[]
  moods               SeriesMood[]
  subtitles           Subtitle[]
  watchHistory        WatchHistory[]
  watchlist           Watchlist[]

  @@index([title])
  @@index([slug])
  @@index([startYear])
  @@index([rating])
  @@index([isTrending])
}

model Season {
  id           String    @id @default(uuid())
  seriesId     String
  seasonNumber Int
  title        String
  overview     String?
  posterUrl    String?
  year         Int?
  episodeCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  episodes     Episode[]
  series       Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, seasonNumber])
  @@index([seriesId])
}

model Episode {
  id                 String          @id @default(uuid())
  seasonId           String
  episodeNumber      Int
  title              String
  overview           String
  runtimeMinutes     Int
  airDate            String?
  thumbnailUrl       String?
  aiRecap            String?
  keyCharacters      String[]        @default([])
  majorThemes        String[]        @default([])
  emotionalTone      String?
  importantEvents    String[]        @default([])
  beforeYouWatchNote String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  aiInsight          AIInsight?
  season             Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  subtitles          Subtitle[]
  watchProgress      WatchProgress[]

  @@unique([seasonId, episodeNumber])
  @@index([seasonId])
}

model Genre {
  id        String        @id @default(uuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())
  movies    MovieGenre[]
  series    SeriesGenre[]

  @@index([slug])
}

model MovieGenre {
  movieId String
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@index([movieId])
  @@index([genreId])
}

model SeriesGenre {
  seriesId String
  genreId  String
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
  @@index([seriesId])
  @@index([genreId])
}

model Mood {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  subtitle    String?
  manifesto   String?
  accentQuote String?
  createdAt   DateTime     @default(now())
  movies      MovieMood[]
  series      SeriesMood[]

  @@index([slug])
}

model MovieMood {
  movieId String
  moodId  String
  mood    Mood   @relation(fields: [moodId], references: [id], onDelete: Cascade)
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([movieId, moodId])
  @@index([movieId])
  @@index([moodId])
}

model SeriesMood {
  seriesId String
  moodId   String
  mood     Mood   @relation(fields: [moodId], references: [id], onDelete: Cascade)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, moodId])
  @@index([seriesId])
  @@index([moodId])
}

model Creator {
  id           String          @id @default(uuid())
  name         String
  slug         String          @unique
  role         String
  portrait     String?
  bio          String?
  bornLocation String?
  manifesto    String?
  filmsCount   Int             @default(0)
  followers    Int             @default(0)
  views        String?
  toolsUsed    String[]        @default([])
  knownFor     String[]        @default([])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movies       MovieCreator[]
  series       SeriesCreator[]

  @@index([slug])
  @@index([name])
}

model MovieCreator {
  movieId   String
  creatorId String
  role      String  @default("Director")
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  movie     Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([movieId, creatorId, role])
  @@index([movieId])
  @@index([creatorId])
}

model SeriesCreator {
  seriesId  String
  creatorId String
  role      String  @default("Creator")
  creator   Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  series    Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, creatorId, role])
  @@index([seriesId])
  @@index([creatorId])
}

model Collection {
  id          String             @id @default(uuid())
  slug        String             @unique
  title       String
  subtitle    String?
  curator     String?
  issue       String?
  heroImage   String
  description String
  tags        String[]           @default([])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  movies      CollectionMovie[]
  series      CollectionSeries[]

  @@index([slug])
}

model CollectionMovie {
  collectionId String
  movieId      String
  order        Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  movie        Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([collectionId, movieId])
  @@index([collectionId])
  @@index([movieId])
}

model CollectionSeries {
  collectionId String
  seriesId     String
  order        Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  series       Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([collectionId, seriesId])
  @@index([collectionId])
  @@index([seriesId])
}

model Provider {
  id           String         @id @default(uuid())
  name         String         @unique
  slug         String         @unique
  logoUrl      String?
  websiteUrl   String?
  createdAt    DateTime       @default(now())
  availability Availability[]

  @@index([slug])
}

model Availability {
  id          String           @id @default(uuid())
  providerId  String
  movieId     String?
  seriesId    String?
  region      String           @default("Global")
  type        AvailabilityType @default(SUBSCRIPTION)
  url         String
  price       String?
  currency    String?
  badge       String?
  available   Boolean          @default(true)
  lastChecked DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  movie       Movie?           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  provider    Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  series      Series?          @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([movieId])
  @@index([seriesId])
  @@index([region])
}

model Subtitle {
  id               String   @id @default(uuid())
  movieId          String?
  seriesId         String?
  episodeId        String?
  language         String
  isAiAssisted     Boolean  @default(false)
  sampleOriginal   String?
  sampleTranslated String?
  createdAt        DateTime @default(now())
  episode          Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  movie            Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series           Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([seriesId])
  @@index([episodeId])
}

model Watchlist {
  id        String            @id @default(uuid())
  userId    String
  movieId   String?
  seriesId  String?
  category  WatchlistCategory @default(WISHLIST)
  userNote  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  movie     Movie?            @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series    Series?           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@unique([userId, seriesId])
  @@index([userId])
  @@index([category])
}

model WatchProgress {
  id              String   @id @default(uuid())
  userId          String
  movieId         String?
  episodeId       String?
  progressSeconds Int      @default(0)
  durationSeconds Int      @default(0)
  percentage      Int      @default(0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  movie           Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@unique([userId, episodeId])
  @@index([userId])
}

model WatchHistory {
  id              String   @id @default(uuid())
  userId          String
  movieId         String?
  seriesId        String?
  seasonNumber    Int?
  episodeNumber   Int?
  watchedAt       DateTime @default(now())
  progressSeconds Int      @default(0)
  completed       Boolean  @default(false)
  movie           Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series          Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([watchedAt])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  movieId   String?
  seriesId  String?
  score     Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@unique([userId, seriesId])
  @@index([userId])
  @@index([score])
}

model AIInsight {
  id                 String   @id @default(uuid())
  movieId            String?  @unique
  seriesId           String?  @unique
  episodeId          String?  @unique
  aiMatchScore       Int?
  whyYouMayLike      String?
  themes             String?
  mood               String?
  visualStyle        String?
  narrativeStyle     String?
  emotionalIntensity String?
  audienceFit        String?
  rawJson            Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  episode            Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  movie              Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series             Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([seriesId])
  @@index([episodeId])
}

enum MediaType {
  MOVIE
  SERIES
  SHORT
  AI_FILM
  DOCUMENTARY
  ANIME
}

enum MediaStatus {
  RELEASED
  UPCOMING
  IN_PRODUCTION
}

enum AvailabilityType {
  FREE
  SUBSCRIPTION
  RENT
  BUY
}

enum WatchlistCategory {
  WISHLIST
  WATCHING
  WATCHED
  FAVORITE
}
