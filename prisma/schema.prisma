generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  username     String          @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         String          @default("USER")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  ratings      Rating[]
  preference   UserPreference?
  watchHistory WatchHistory[]
  progress     WatchProgress[]
  watchlist    Watchlist[]
  auditLogs    AdminAuditLog[]
  jobs         Job[]

  @@index([email])
  @@index([username])
}

model UserPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  favoriteGenres        String[] @default([])
  favoriteMoods         String[] @default([])
  favoriteLanguages     String[] @default([])
  preferredRuntime      String?
  preferredContentTypes String[] @default([])
  preferredProviders    String[] @default([])
  editorialSummary      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Movie {
  id                  String            @id @default(uuid())
  slug                String            @unique
  title               String
  originalTitle       String?
  tagline             String?
  synopsis            String
  year                Int
  runtimeMinutes      Int
  rating              Float             @default(0.0)
  posterUrl           String
  backdropUrl         String
  monochromePosterUrl String?
  trailerYoutubeId    String?
  type                MediaType         @default(MOVIE)
  status              MediaStatus       @default(RELEASED)
  isCoverFeature      Boolean           @default(false)
  isTrending          Boolean           @default(false)
  editorialQuote      String?
  isAiFilm            Boolean           @default(false)
  toolsUsed           String[]          @default([])
  promptDirector      String?
  workflowNotes       String?
  normalizedTitle     String?           @unique
  streamUrl           String?
  streamType          StreamType?
  sourceName          String?
  sourceUrl           String?
  rawTitle            String?
  lastScrapedAt       DateTime?
  /// Visibility on the public site. Separate from `status` (release status).
  publishStatus       PublishStatus     @default(PUBLISHED)
  publishedAt         DateTime?
  language            String?
  country             String?
  ageRating           String?
  releaseDate         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  aiInsight           AIInsight?
  availability        Availability[]
  collectionItems     CollectionMovie[]
  creators            MovieCreator[]
  externalIds         ExternalId[]
  genres              MovieGenre[]
  mediaAssets         MediaAsset[]
  moods               MovieMood[]
  ratings             Rating[]
  subtitles           Subtitle[]
  watchHistory        WatchHistory[]
  watchProgress       WatchProgress[]
  watchlist           Watchlist[]

  @@index([title])
  @@index([slug])
  @@index([year])
  @@index([rating])
  @@index([type])
  @@index([isTrending])
  @@index([publishStatus, createdAt])
}

model Series {
  id                  String             @id @default(uuid())
  slug                String             @unique
  title               String
  originalTitle       String?
  tagline             String?
  synopsis            String
  startYear           Int
  endYear             Int?
  rating              Float              @default(0.0)
  posterUrl           String
  backdropUrl         String
  monochromePosterUrl String?
  trailerYoutubeId    String?
  status              MediaStatus        @default(RELEASED)
  isCoverFeature      Boolean            @default(false)
  isTrending          Boolean            @default(false)
  editorialQuote      String?
  normalizedTitle     String?            @unique
  sourceName          String?
  publishStatus       PublishStatus      @default(PUBLISHED)
  publishedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  aiInsight           AIInsight?
  availability        Availability[]
  collectionItems     CollectionSeries[]
  externalIds         ExternalId[]
  ratings             Rating[]
  seasons             Season[]
  creators            SeriesCreator[]
  genres              SeriesGenre[]
  moods               SeriesMood[]
  subtitles           Subtitle[]
  watchHistory        WatchHistory[]
  watchlist           Watchlist[]

  @@index([title])
  @@index([slug])
  @@index([startYear])
  @@index([rating])
  @@index([isTrending])
  @@index([publishStatus, createdAt])
}

model Season {
  id            String        @id @default(uuid())
  seriesId      String
  seasonNumber  Int
  title         String
  overview      String?
  posterUrl     String?
  year          Int?
  episodeCount  Int           @default(0)
  publishStatus PublishStatus @default(PUBLISHED)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  episodes      Episode[]
  externalIds   ExternalId[]
  series        Series        @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, seasonNumber])
  @@index([seriesId])
}

model Episode {
  id                 String          @id @default(uuid())
  seasonId           String
  episodeNumber      Int
  title              String
  overview           String
  runtimeMinutes     Int
  airDate            String?
  thumbnailUrl       String?
  aiRecap            String?
  keyCharacters      String[]        @default([])
  majorThemes        String[]        @default([])
  emotionalTone      String?
  importantEvents    String[]        @default([])
  beforeYouWatchNote String?
  slug               String?
  streamUrl          String?
  streamType         StreamType?
  sourceName         String?
  sourceUrl          String?
  rawTitle           String?
  lastScrapedAt      DateTime?
  /// Replaces the free-text `airDate` once backfilled.
  airDateAt          DateTime?
  /// Display order within the season; falls back to episodeNumber when null.
  sortOrder          Int?
  publishStatus      PublishStatus   @default(PUBLISHED)
  publishedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  aiInsight          AIInsight?
  externalIds        ExternalId[]
  mediaAssets        MediaAsset[]
  season             Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  subtitles          Subtitle[]
  watchProgress      WatchProgress[]

  @@unique([seasonId, episodeNumber])
  @@index([seasonId])
  @@index([slug])
  @@index([publishStatus])
}

model Genre {
  id        String        @id @default(uuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())
  movies    MovieGenre[]
  series    SeriesGenre[]

  @@index([slug])
}

model MovieGenre {
  movieId String
  genreId String
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
  @@index([movieId])
  @@index([genreId])
}

model SeriesGenre {
  seriesId String
  genreId  String
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
  @@index([seriesId])
  @@index([genreId])
}

model Mood {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  subtitle    String?
  manifesto   String?
  accentQuote String?
  createdAt   DateTime     @default(now())
  movies      MovieMood[]
  series      SeriesMood[]

  @@index([slug])
}

model MovieMood {
  movieId String
  moodId  String
  mood    Mood   @relation(fields: [moodId], references: [id], onDelete: Cascade)
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([movieId, moodId])
  @@index([movieId])
  @@index([moodId])
}

model SeriesMood {
  seriesId String
  moodId   String
  mood     Mood   @relation(fields: [moodId], references: [id], onDelete: Cascade)
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, moodId])
  @@index([seriesId])
  @@index([moodId])
}

model Creator {
  id           String          @id @default(uuid())
  name         String
  slug         String          @unique
  role         String
  portrait     String?
  bio          String?
  bornLocation String?
  manifesto    String?
  filmsCount   Int             @default(0)
  followers    Int             @default(0)
  views        String?
  toolsUsed    String[]        @default([])
  knownFor     String[]        @default([])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movies       MovieCreator[]
  series       SeriesCreator[]

  @@index([slug])
  @@index([name])
}

model MovieCreator {
  movieId      String
  creatorId    String
  role         String  @default("Director")
  character    String?
  billingOrder Int     @default(0)
  creator      Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  movie        Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([movieId, creatorId, role])
  @@index([movieId])
  @@index([creatorId])
}

model SeriesCreator {
  seriesId     String
  creatorId    String
  role         String  @default("Creator")
  character    String?
  billingOrder Int     @default(0)
  creator      Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  series       Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, creatorId, role])
  @@index([seriesId])
  @@index([creatorId])
}

model Collection {
  id          String             @id @default(uuid())
  slug        String             @unique
  title       String
  subtitle    String?
  curator     String?
  issue       String?
  heroImage   String
  description String
  tags        String[]           @default([])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  movies      CollectionMovie[]
  series      CollectionSeries[]

  @@index([slug])
}

model CollectionMovie {
  collectionId String
  movieId      String
  order        Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  movie        Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([collectionId, movieId])
  @@index([collectionId])
  @@index([movieId])
}

model CollectionSeries {
  collectionId String
  seriesId     String
  order        Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  series       Series     @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([collectionId, seriesId])
  @@index([collectionId])
  @@index([seriesId])
}

model Provider {
  id           String         @id @default(uuid())
  name         String         @unique
  slug         String         @unique
  logoUrl      String?
  websiteUrl   String?
  createdAt    DateTime       @default(now())
  availability Availability[]

  @@index([slug])
}

model Availability {
  id          String           @id @default(uuid())
  providerId  String
  movieId     String?
  seriesId    String?
  region      String           @default("Global")
  type        AvailabilityType @default(SUBSCRIPTION)
  url         String
  price       String?
  currency    String?
  badge       String?
  available   Boolean          @default(true)
  lastChecked DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  movie       Movie?           @relation(fields: [movieId], references: [id], onDelete: Cascade)
  provider    Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  series      Series?          @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([movieId])
  @@index([seriesId])
  @@index([region])
}

model Subtitle {
  id               String      @id @default(uuid())
  movieId          String?
  seriesId         String?
  episodeId        String?
  language         String
  isAiAssisted     Boolean     @default(false)
  sampleOriginal   String?
  sampleTranslated String?
  /// Playable text track (WebVTT by default), stored in object storage or at `url`.
  mediaAssetId     String?
  label            String?
  format           String      @default("vtt")
  storageKey       String?
  url              String?
  isDefault        Boolean     @default(false)
  createdAt        DateTime    @default(now())
  episode          Episode?    @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  mediaAsset       MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  movie            Movie?      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series           Series?     @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([seriesId])
  @@index([episodeId])
  @@index([mediaAssetId])
}

model Watchlist {
  id        String            @id @default(uuid())
  userId    String
  movieId   String?
  seriesId  String?
  category  WatchlistCategory @default(WISHLIST)
  userNote  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  movie     Movie?            @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series    Series?           @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@unique([userId, seriesId])
  @@index([userId])
  @@index([category])
}

model WatchProgress {
  id              String   @id @default(uuid())
  userId          String
  movieId         String?
  episodeId       String?
  progressSeconds Int      @default(0)
  durationSeconds Int      @default(0)
  percentage      Int      @default(0)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  episode         Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  movie           Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@unique([userId, episodeId])
  @@index([userId])
}

model WatchHistory {
  id              String   @id @default(uuid())
  userId          String
  movieId         String?
  seriesId        String?
  seasonNumber    Int?
  episodeNumber   Int?
  watchedAt       DateTime @default(now())
  progressSeconds Int      @default(0)
  completed       Boolean  @default(false)
  movie           Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series          Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([watchedAt])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  movieId   String?
  seriesId  String?
  score     Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@unique([userId, seriesId])
  @@index([userId])
  @@index([score])
}

model AIInsight {
  id                 String   @id @default(uuid())
  movieId            String?  @unique
  seriesId           String?  @unique
  episodeId          String?  @unique
  aiMatchScore       Int?
  whyYouMayLike      String?
  themes             String?
  mood               String?
  visualStyle        String?
  narrativeStyle     String?
  emotionalIntensity String?
  audienceFit        String?
  rawJson            Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  episode            Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  movie              Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  series             Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([seriesId])
  @@index([episodeId])
}

enum MediaType {
  MOVIE
  SERIES
  SHORT
  AI_FILM
  DOCUMENTARY
  ANIME
}

enum MediaStatus {
  RELEASED
  UPCOMING
  IN_PRODUCTION
}

enum AvailabilityType {
  FREE
  SUBSCRIPTION
  RENT
  BUY
}

enum WatchlistCategory {
  WISHLIST
  WATCHING
  WATCHED
  FAVORITE
}

enum StreamType {
  HLS
  FILE
  EMBED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProviderKind {
  METADATA
  MEDIA
}

enum MediaAssetStatus {
  PENDING
  VALIDATING
  PROCESSING
  READY
  FAILED
  DISABLED
}

enum DeliveryType {
  HLS
  DASH
  FILE
  EMBED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
  RETRYING
}

/// A metadata API or an authorized media source. Not the same as `Provider`
/// (watch providers such as streaming services). Secrets live in env vars only.
model IngestionProvider {
  id               String       @id @default(uuid())
  key              String       @unique
  name             String
  kind             ProviderKind
  enabled          Boolean      @default(true)
  /// Non-secret settings (rate limits, default language, ...).
  config           Json         @default("{}")
  /// Authorization record for MEDIA providers: what allows us to use this content.
  licenseRef       String?
  licenseNotes     String?
  /// Hosts media may be fetched from. Empty means no remote fetching.
  allowedHosts     String[]     @default([])
  licenseExpiresAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  externalIds      ExternalId[]
  mediaAssets      MediaAsset[]
}

/// Provider identity of a title: the primary deduplication key.
model ExternalId {
  id           String            @id @default(uuid())
  providerId   String
  /// MOVIE | SERIES | SEASON | EPISODE
  entityType   String
  externalId   String
  movieId      String?
  seriesId     String?
  seasonId     String?
  episodeId    String?
  lastSyncedAt DateTime?
  createdAt    DateTime          @default(now())
  episode      Episode?          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  movie        Movie?            @relation(fields: [movieId], references: [id], onDelete: Cascade)
  provider     IngestionProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  season       Season?           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  series       Series?           @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([providerId, entityType, externalId])
  @@index([movieId])
  @@index([seriesId])
  @@index([seasonId])
  @@index([episodeId])
}

/// One playable version of a movie or episode, from one provider.
model MediaAsset {
  id              String            @id @default(uuid())
  movieId         String?
  episodeId       String?
  providerId      String
  /// UPLOAD | URL | EMBED | OBJECT_STORAGE
  sourceType      String
  /// Original URL, or storage key of the original file.
  sourceRef       String
  status          MediaAssetStatus  @default(PENDING)
  deliveryType    DeliveryType
  /// Object-storage prefix holding renditions and manifests.
  storagePrefix   String?
  /// Master manifest key; resolved to a CDN URL when read.
  manifestKey     String?
  /// Direct playback URL for assets that are not re-hosted (embeds, external files).
  playbackUrl     String?
  durationSeconds Int?
  width           Int?
  height          Int?
  videoCodec      String?
  audioCodec      String?
  bitrateKbps     Int?
  sizeBytes       BigInt?
  /// sha256 of the original file; detects re-imports of the same media.
  checksum        String?
  /// [{ height, bitrateKbps, codec, playlistKey }]
  renditions      Json?
  /// ffprobe summary of the original.
  probe           Json?
  isPrimary       Boolean           @default(false)
  priority        Int               @default(0)
  error           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  episode         Episode?          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  movie           Movie?            @relation(fields: [movieId], references: [id], onDelete: Cascade)
  provider        IngestionProvider @relation(fields: [providerId], references: [id])
  subtitles       Subtitle[]

  @@unique([movieId, providerId, sourceRef])
  @@unique([episodeId, providerId, sourceRef])
  @@index([movieId, status])
  @@index([episodeId, status])
  @@index([providerId])
  @@index([status])
}

/// Background job: imports, metadata refreshes and media processing.
model Job {
  id              String     @id @default(uuid())
  /// IMPORT_MOVIES | IMPORT_SERIES | IMPORT_SEASON | PROCESS_MEDIA | ... (validated in code)
  type            String
  status          JobStatus  @default(QUEUED)
  priority        Int        @default(0)
  payload         Json
  result          Json?
  /// 0..100
  progress        Int        @default(0)
  processed       Int        @default(0)
  succeeded       Int        @default(0)
  skipped         Int        @default(0)
  failed          Int        @default(0)
  attempts        Int        @default(0)
  maxAttempts     Int        @default(3)
  /// Earliest time the job may run (used for retry backoff).
  runAt           DateTime   @default(now())
  lockedAt        DateTime?
  lockedBy        String?
  /// Idempotency key for the kind of work, e.g. "import:tmdb:movie:603".
  dedupeKey       String?
  /// Equals dedupeKey while the job is QUEUED/RUNNING/RETRYING, null otherwise,
  /// so at most one active job exists per key.
  activeDedupeKey String?    @unique
  error           String?
  /// TRANSIENT | PERMANENT
  errorKind       String?
  cancelRequested Boolean    @default(false)
  parentId        String?
  createdById     String?
  createdAt       DateTime   @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  children        Job[]      @relation("JobChildren")
  createdBy       User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  events          JobEvent[]
  parent          Job?       @relation("JobChildren", fields: [parentId], references: [id], onDelete: Cascade)

  @@index([status, runAt, priority])
  @@index([type, status])
  @@index([parentId])
  @@index([dedupeKey])
  @@index([createdAt])
}

/// Stage-level log line for a job, so every pipeline stage is observable.
model JobEvent {
  id         String   @id @default(uuid())
  jobId      String
  /// DISCOVER | FETCH_METADATA | NORMALIZE | DEDUPLICATE | VALIDATE | STORE_METADATA | ...
  stage      String
  /// info | warn | error
  level      String
  message    String
  data       Json?
  durationMs Int?
  createdAt  DateTime @default(now())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

/// Who changed what in the admin area. Kept when the actor account is deleted.
model AdminAuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  /// Snapshot of the actor, so entries stay readable after the account is gone.
  actorEmail   String
  /// movie.update, movie.publish, job.cancel, provider.update, user.role, ...
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}
